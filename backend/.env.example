PORT=5000
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/quikbite
MONGO_DATABASE=quikbite
JWT_SECRET=replace_with_a_strong_secret
ADMIN_EMAIL=admin@quikbite.com
ADMIN_PASSWORD=replace_with_a_strong_password
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
IMAGE_STORAGE=local
UPLOAD_DIR=uploads
MAX_BODY_SIZE=10485760

# Render production values:
# ENVIRONMENT=production
# IMAGE_STORAGE=cloudinary
# CORS_ORIGINS=https://your-store.vercel.app,https://your-admin.vercel.app
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_restricted_preset
# JWT_SECRET must be at least 32 non-default characters in production.
